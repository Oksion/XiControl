<?xml version="1.0" encoding="utf-8"?>
<!-- Настройки сбора покрытия для dotnet test. SonarCloud читает OpenCover-формат
     (sonar.cs.opencover.reportsPaths). Сам тест-проект из покрытия исключаем. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Exclude>[XiControl.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
