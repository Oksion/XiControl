<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Nullable / ImplicitUsings / LangVersion — в Directory.Build.props -->
    <AssemblyName>IconPreview</AssemblyName>
    <!-- XiControl is a self-contained win-x64 executable in Release. Referencing it from an
         executable tool requires the tool to use the same runtime/deployment model. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- для рендера/сверки сгенерированного SVG -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Svg" Version="3.4.7" />
    <ProjectReference Include="..\..\src\XiControl.csproj" />
  </ItemGroup>

</Project>
